# Copy to .env (gitignored) and fill in real values. Never commit .env.
FOUNDRY_ENDPOINT=https://your-resource-name.openai.azure.com/
FOUNDRY_API_KEY=your-api-key-here
FOUNDRY_DEPLOYMENT=your-deployment-name
# Optional; must be a version that supports json_schema structured outputs.
FOUNDRY_API_VERSION=2024-10-21
