# Large datasets
*.jsonl
*.jsonl.gz
*.gz

# Secrets (LLM provider keys)
.env

# Embeddings / vector index artifacts (built from the corpus; never commit)
DATA/embeddings/
*.faiss
*.npy
*.npz

# Logs
*.log
logs/

# SLURM output
slurm-*.out

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS/editor files
.DS_Store
.vscode/

# Allow small development samples in GitHub
!DATA/samples/
!DATA/samples/*.jsonl


# SLURM job files and logs
*.slurm
*_*.out
*_*.err

# Retrieval indexes (rebuild locally)
indexes/
