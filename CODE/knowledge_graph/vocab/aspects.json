    ],
    "contrast_markers": [
      "but",
      "however",
      "although",
      "though",
      "except",
      "yet",
      "unfortunately"
    ],
    "aggregation": {
      "min_positive_reviews": 2,
      "positive_to_critical_ratio": 2.0,
      "concern_min_negative_reviews": 2,
      "conflict_max_rating": 2,
      "description": "Product -HAS_ASPECT-> quality aspect only when at least min_positive_reviews distinct reviews (distinct text) give positive evidence without a rating conflict, and positive reviews number at least positive_to_critical_ratio times the negative plus mixed reviews. Negative-majority aspects become review concerns on the product, never HAS_ASPECT."
    }
  }
