  "changelog": [
    {
      "version": "1.2.0",
      "changes": [
        "review_cues for the 12 quality aspects",
        "review_inference settings (negation, hedges, contrast, aggregation policy)",
        "context_exclude (durability ignores packaging/shipping clauses)",
        "cue exclusions for ambiguous phrases (engaging in, worth reading, break in)",
        "durability ignores injuries (broken wrist, broke his arm)"
      ]
    },
    {
      "version": "1.1.0",
      "changes": [
        "component_guard on material aspects",
        "cross-sell sentences ignored in features",
        "excludes for instructions and surface finishes"
      ]
    },
    {
      "version": "1.0.0",
      "changes": [
        "initial 16 attribute + 12 quality aspects"
      ]
    }
  ],
  "review_inference": {
    "classifier": "review_rules",
    "notes": [
      "Review cues are matched only in review text, never in seller listing text.",
      "Star ratings are never evidence on their own. They are recorded on each SUPPORTS edge, and a positive mention in a review rated at or below conflict_max_rating is flagged rating_conflict and excluded from aggregation.",
      "A positive cue that is negated in its clause becomes negative evidence. A negated negative cue ('didn't break') becomes neutral, not positive. Hedged or questioning sentences ('hope it lasts', 'is it sturdy?') are neutral.",
      "Sentences are split into clauses at contrast words (but, however, although...), so 'cute but broke in a week' yields separate evidence per clause.",
      "A review with positive and negative evidence for the same aspect is 'mixed'. Mixed reviews never count as support.",
      "Negation and hedges are scoped to the clause up to the nearest comma before the cue, so 'If you want X, this kit is overpriced' is still negative.",
      "context_exclude: an aspect is skipped for a clause that mentions one of these words (durability is not judged from clauses about the box, packaging or shipping; see packaging_presentation)."
    ],
    "confidence": {
      "direct": 0.7,
      "negated_positive": 0.6,
      "neutral": 0.5
    },
    "negators": [
      "not",
      "no",
      "never",
      "isn't",
      "wasn't",
      "aren't",
      "weren't",
      "doesn't",
      "didn't",
      "don't",
      "won't",
      "can't",
      "cannot",
      "couldn't",
      "wouldn't",
      "hardly",
      "barely",
      "nothing",
      "neither",
      "nor",
      "hasn't",
      "haven't",
      "hadn't",
      "shouldn't",
      "isnt",
      "wasnt",
      "arent",
      "werent",
      "doesnt",
      "didnt",
      "dont",
      "wont",
      "cant",
      "couldnt",
      "wouldnt",
      "hasnt",
      "havent",
      "hadnt"
    ],
    "negation_window_tokens": 3,
    "negation_exceptions": [
      "not only",
      "no doubt"
    ],
    "hedges": [
      "hope",
      "hopefully",
      "hoping",
      "if",
